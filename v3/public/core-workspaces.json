{
  "schemaVersion": "3.1.0",
  "claimClass": "core-workspace-contract",
  "primaryQuestion": "Che cosa richiede attenzione?",
  "workspaces": [
    {
      "id": "monitoring",
      "label": "Monitoraggio",
      "shortLabel": "Monitoraggio",
      "description": "Osserva, rivedi e collega una variazione.",
      "primaryInputs": [
        "URL monitorato",
        "contenuto aggiunto"
      ],
      "flow": [
        "Osserva",
        "Rivedi",
        "Decidi",
        "Collega",
        "Prova"
      ],
      "boundary": "ICTC confronta e propone; una persona autorizzata decide rilevanza e impatto nel cliente selezionato."
    },
    {
      "id": "incidents",
      "label": "Incidenti",
      "shortLabel": "Incidenti",
      "description": "Segnala, gestisci, ripristina e apprendi.",
      "primaryInputs": [
        "segnalazione"
      ],
      "flow": [
        "Segnala",
        "Assegna",
        "Valuta",
        "Rispondi",
        "Ripristina",
        "Impara",
        "Prova"
      ],
      "boundary": "Il workflow conserva fatti e decisioni; non determina automaticamente qualificazione normativa o obblighi di notifica."
    }
  ],
  "visibleObjects": [
    {
      "id": "tenant-context",
      "purpose": "Separa cliente, membership e audit trail senza diventare un terzo servizio.",
      "usedBy": [
        "monitoring-job",
        "matter",
        "receipt"
      ],
      "userAction": "select"
    },
    {
      "id": "monitoring-job",
      "purpose": "Definisce fonte, frequenza e domanda di studio nel cliente selezionato.",
      "usedBy": [
        "source",
        "finding"
      ],
      "userAction": "create-schedule-run"
    },
    {
      "id": "source",
      "purpose": "Conserva origine e impronta del contenuto osservato.",
      "usedBy": [
        "finding"
      ],
      "userAction": "review"
    },
    {
      "id": "finding",
      "purpose": "Rende revisionabile una differenza senza attribuirle materialità.",
      "usedBy": [
        "change"
      ],
      "userAction": "review"
    },
    {
      "id": "change",
      "purpose": "Conserva la decisione umana sull’impatto locale.",
      "usedBy": [
        "control"
      ],
      "userAction": "decide"
    },
    {
      "id": "control",
      "purpose": "Documenta una relazione con un presidio, non la sua efficacia.",
      "usedBy": [],
      "userAction": "map"
    },
    {
      "id": "matter",
      "purpose": "Conserva fatti, responsabilità, evidenze e stato del caso.",
      "usedBy": [
        "incident-phase-evidence"
      ],
      "userAction": "advance"
    },
    {
      "id": "incident-phase-evidence",
      "purpose": "Conserva le informazioni minime richieste per ogni passaggio.",
      "usedBy": [
        "matter"
      ],
      "userAction": "record"
    },
    {
      "id": "receipt",
      "purpose": "Prova tenant, attore, ruolo, evento, hash e readback della scrittura.",
      "usedBy": [],
      "userAction": "inspect"
    }
  ],
  "actions": [
    {
      "id": "access-read",
      "route": "GET /api/access",
      "permission": "read",
      "receiptExpected": false,
      "userLabel": "Apri contesto",
      "event": null,
      "producer": "access-context",
      "projection": "access-view",
      "method": "GET",
      "path": "/api/access"
    },
    {
      "id": "job-create",
      "route": "POST /api/jobs",
      "permission": "observe",
      "receiptExpected": true,
      "userLabel": "Monitora URL",
      "event": "job.created",
      "producer": "human-monitoring-configuration",
      "projection": "monitoring-task",
      "method": "POST",
      "path": "/api/jobs"
    },
    {
      "id": "job-schedule",
      "route": "POST /api/jobs/:id/schedule",
      "permission": "run",
      "receiptExpected": true,
      "userLabel": "Attiva",
      "event": "job.scheduled",
      "producer": "human-monitoring-configuration",
      "projection": "monitoring-task",
      "method": "POST",
      "path": "/api/jobs/:id/schedule"
    },
    {
      "id": "job-run",
      "route": "POST /api/jobs/:id/run",
      "permission": "run",
      "receiptExpected": true,
      "userLabel": "Esegui",
      "event": "job.completed",
      "producer": "remote-observation",
      "projection": "monitoring-task",
      "method": "POST",
      "path": "/api/jobs/:id/run"
    },
    {
      "id": "source-propose",
      "route": "POST /api/sources",
      "permission": "observe",
      "receiptExpected": true,
      "userLabel": "Aggiungi contenuto",
      "event": "source.proposed",
      "producer": "human-input",
      "projection": "source-and-finding",
      "method": "POST",
      "path": "/api/sources"
    },
    {
      "id": "source-review",
      "route": "POST /api/sources/:id/review",
      "permission": "review",
      "receiptExpected": true,
      "userLabel": "Rivedi",
      "event": "source.reviewed",
      "producer": "human-review",
      "projection": "source-review-task",
      "method": "POST",
      "path": "/api/sources/:id/review"
    },
    {
      "id": "finding-review",
      "route": "POST /api/findings/:id/review",
      "permission": "review",
      "receiptExpected": true,
      "userLabel": "Valuta",
      "event": "finding.reviewed",
      "producer": "human-review",
      "projection": "finding-review-task",
      "method": "POST",
      "path": "/api/findings/:id/review"
    },
    {
      "id": "change-decision",
      "route": "POST /api/changes/:id/decide",
      "permission": "decide",
      "receiptExpected": true,
      "userLabel": "Decidi",
      "event": "change.decided",
      "producer": "human-decision",
      "projection": "change-decision-task",
      "method": "POST",
      "path": "/api/changes/:id/decide"
    },
    {
      "id": "control-map",
      "route": "POST /api/changes/:id/map-control",
      "permission": "decide",
      "receiptExpected": true,
      "userLabel": "Collega",
      "event": "change.control.mapped",
      "producer": "human-mapping",
      "projection": "control-map-task",
      "method": "POST",
      "path": "/api/changes/:id/map-control"
    },
    {
      "id": "matter-create",
      "route": "POST /api/matters",
      "permission": "report",
      "receiptExpected": true,
      "userLabel": "Segnala",
      "event": "matter.reported",
      "producer": "human-report",
      "projection": "matter-task",
      "method": "POST",
      "path": "/api/matters"
    },
    {
      "id": "matter-owner",
      "route": "POST /api/matters/:id/confirm-owner",
      "permission": "manage-case",
      "receiptExpected": true,
      "userLabel": "Conferma",
      "event": "matter.owner.confirmed",
      "producer": "human-decision",
      "projection": "matter-owner-task",
      "method": "POST",
      "path": "/api/matters/:id/confirm-owner"
    },
    {
      "id": "matter-transition",
      "route": "POST /api/matters/:id/transition",
      "permission": "manage-case",
      "receiptExpected": true,
      "userLabel": "Avanza",
      "event": "matter.transitioned",
      "producer": "human-transition",
      "projection": "matter-transition-task",
      "method": "POST",
      "path": "/api/matters/:id/transition"
    },
    {
      "id": "object-open",
      "route": "GET /api/objects/:id",
      "permission": "read",
      "receiptExpected": false,
      "userLabel": "Dettagli",
      "event": null,
      "producer": "object-projector",
      "projection": "object-detail",
      "method": "GET",
      "path": "/api/objects/:id"
    },
    {
      "id": "search",
      "route": "GET /api/bootstrap",
      "permission": "read",
      "receiptExpected": false,
      "userLabel": "Cerca",
      "event": null,
      "producer": "search-projector",
      "projection": "object-search",
      "method": "GET",
      "path": "/api/bootstrap"
    }
  ],
  "incidentPhases": [
    {
      "from": "owned",
      "to": "assessing",
      "phase": "triage",
      "label": "Registra il triage",
      "summary": "Qualifica segnale, impatto e perimetro.",
      "fields": [
        {
          "id": "classification",
          "label": "Classificazione",
          "type": "select",
          "required": true,
          "options": [["event","Evento"],["near-miss","Quasi incidente"],["incident","Incidente"]]
        },
        {
          "id": "severity",
          "label": "Severità",
          "type": "select",
          "required": true,
          "options": [["low","Bassa"],["medium","Media"],["high","Alta"],["critical","Critica"]]
        },
        {"id":"scope","label":"Perimetro noto","type":"textarea","required":true},
        {"id":"impact","label":"Impatto osservato o potenziale","type":"textarea","required":true},
        {
          "id": "confidence",
          "label": "Confidenza",
          "type": "select",
          "required": true,
          "options": [["low","Bassa"],["medium","Media"],["high","Alta"]]
        }
      ]
    },
    {
      "from":"assessing","to":"responding","phase":"response","label":"Avvia la risposta","summary":"Registra contenimento, causa e comunicazioni.",
      "fields":[{"id":"containment","label":"Contenimento","type":"textarea","required":true},{"id":"eradication","label":"Rimozione della causa","type":"textarea","required":true},{"id":"communications","label":"Comunicazioni e valutazioni di notifica","type":"textarea","required":true}]
    },
    {
      "from":"responding","to":"closure-review","phase":"recovery","label":"Registra il ripristino","summary":"Documenta ripristino, verifica e monitoraggio residuo.",
      "fields":[{"id":"serviceStatus","label":"Stato del servizio","type":"select","required":true,"options":[["restored","Ripristinato"],["degraded","Degradato"],["not-applicable","Non applicabile"]]},{"id":"recoveryValidation","label":"Validazione del ripristino","type":"textarea","required":true},{"id":"residualMonitoring","label":"Monitoraggio residuo","type":"textarea","required":true}]
    },
    {
      "from":"closure-review","to":"closed","phase":"lessons","label":"Chiudi il caso","summary":"Conserva lezioni, azioni e approvazione.",
      "fields":[{"id":"lessonsLearned","label":"Lezioni apprese","type":"textarea","required":true},{"id":"followUpActions","label":"Azioni successive","type":"textarea","required":true},{"id":"approvedBy","label":"Approvata da","type":"text","required":true}]
    }
  ],
  "copyRules": {
    "maximumPrimaryActions": 1,
    "maximumMonitoringServiceActions": 2,
    "maximumIncidentServiceActions": 1,
    "maximumPrimaryDescriptionWords": 12,
    "forbiddenPrimaryTerms": ["journey","SOT","lente","claim class","checkpoint","readback","proiezione","job"],
    "emptyStateBoundary": "Nessun elemento aperto non significa conformità, completezza o assenza di rischio.",
    "maximumHeaderActions": 2
  },
  "limitations": [
    "La modalità local-directory è una simulazione locale, non autenticazione.",
    "La modalità trusted-header richiede un identity-aware proxy amministrato e il flag ICTC_TRUSTED_IDENTITY_BOUNDARY=1.",
    "Ledger e blob sono isolati per tenant nello stesso processo; non costituiscono storage distribuito o alta disponibilità.",
    "Ricevute e hash-chain provano operazioni tecniche, non la verità del contenuto o l’efficacia dei controlli."
  ],
  "operatingScenarios": [
    {"id":"enterprise","label":"Azienda","services":["monitoring","incidents"],"typicalInputs":["aggiornamento normativo","anomalia di fornitore"],"roles":["Compliance Owner","DPO","CISO","Process Owner"],"highLeverageContext":["unità organizzativa","processo interessato","sistema o fornitore"],"boundary":"Il tipo organizzativo deriva dal tenant e non è modificabile dal payload."},
    {"id":"public-administration","label":"Ente pubblico o istituzione","services":["monitoring","incidents"],"typicalInputs":["fonte istituzionale","evento su servizio pubblico"],"roles":["Dirigente responsabile","DPO","RTD","Responsabile del procedimento"],"highLeverageContext":["amministrazione","servizio o procedimento","ufficio competente"],"boundary":"Il tipo organizzativo deriva dal tenant e non determina competenza o regime documentale."},
    {"id":"regulated-enterprise","label":"Impresa regolamentata","services":["monitoring","incidents"],"typicalInputs":["fonte dell’autorità","evento cyber o operativo"],"roles":["Compliance","Risk","Legal","DPO","CISO"],"highLeverageContext":["perimetro regolato","servizio essenziale","giurisdizione"],"boundary":"Il tipo organizzativo deriva dal tenant e non attribuisce applicabilità o materialità."}
  ],
  "roles": [
    {"id":"viewer","label":"Lettore","permissions":["read"]},
    {"id":"analyst","label":"Analista","permissions":["read","observe","run","report"]},
    {"id":"reviewer","label":"Reviewer","permissions":["read","observe","run","report","review"]},
    {"id":"owner","label":"Owner","permissions":["read","observe","run","report","review","decide","manage-case"]},
    {"id":"admin","label":"Admin","permissions":["read","observe","run","report","review","decide","manage-case","admin"]}
  ]
}
