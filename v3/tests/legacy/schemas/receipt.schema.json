{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/receipt.schema.json",
  "title": "ICTC Receipt",
  "type": "object",
  "required": ["eventId", "eventType", "hash", "previousHash", "persistedAt", "readbackVerified", "ledgerHead"],
  "properties": {
    "eventId": {"type": "string"},
    "eventType": {"type": "string"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "previousHash": {"type": "string"},
    "persistedAt": {"type": "string", "format": "date-time"},
    "readbackVerified": {"const": true},
    "ledgerHead": {"type": "string"}
  },
  "additionalProperties": false
}
