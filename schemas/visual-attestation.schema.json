{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/visual-attestation.schema.json",
  "title": "ICTC Visual Validation Attestation",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "mode", "inspectedBy", "viewport", "artifacts", "checks", "limitation"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["real-browser", "fallback-static"]},
    "inspectedBy": {"type": "string", "minLength": 1},
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {"width": {"type": "integer", "minimum": 320}, "height": {"type": "integer", "minimum": 480}},
      "additionalProperties": false
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitation": {"type": "string"}
  },
  "additionalProperties": false
}
