{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/action-frame.schema.json",
  "title": "ICTC ActionFrame",
  "type": "object",
  "required": ["id","claimClass","epistemicStatus","label","statement","userQuestion","processRef","action","prerequisites","consequence","doesNotMean","evidenceAfter","producer","inputs","limitations","nextAction","availability"],
  "properties": {
    "id": {"type":"string","pattern":"^action-frame-"},
    "claimClass": {"const":"action-frame"},
    "epistemicStatus": {"enum":["derived-guidance","unavailable"]},
    "label": {"type":"string","minLength":1},
    "statement": {"type":"string","minLength":1},
    "userQuestion": {"type":"string","minLength":1},
    "objectRef": {"type":["string","null"]},
    "processRef": {"type":"string","minLength":1},
    "action": {
      "type":"object",
      "required":["kind","value","label"],
      "properties": {
        "kind":{"enum":["object","dialog","view","selector"]},
        "value":{"type":"string","minLength":1},
        "label":{"type":"string","minLength":1}
      },
      "additionalProperties":false
    },
    "prerequisites":{"type":"array","items":{"type":"string"}},
    "consequence":{"type":"string","minLength":1},
    "doesNotMean":{"type":"array","items":{"type":"string"},"minItems":1},
    "evidenceAfter":{"type":"array","items":{"type":"string"},"minItems":1},
    "producer":{"type":"object","required":["id","type"]},
    "inputs":{"type":"array"},
    "limitations":{"type":"array","items":{"type":"string"},"minItems":1},
    "nextAction":{"type":"string","minLength":1},
    "availability":{"enum":["available","blocked"]},
    "writeActionId":{"type":["string","null"]}
  },
  "additionalProperties":true
}
