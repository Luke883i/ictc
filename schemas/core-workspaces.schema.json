{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/core-workspaces.schema.json",
  "title": "ICTC multi-client core workspace contract",
  "type": "object",
  "required": ["schemaVersion","claimClass","primaryQuestion","workspaces","visibleObjects","actions","incidentPhases","copyRules","limitations","operatingScenarios","roles"],
  "properties": {
    "schemaVersion": {"const": "3.1.0"},
    "claimClass": {"const": "core-workspace-contract"},
    "primaryQuestion": {"type": "string", "minLength": 10},
    "workspaces": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["id","label","description","flow","boundary"]}},
    "visibleObjects": {"type":"array","minItems":9,"items":{"type":"object","required":["id","purpose","usedBy","userAction"]}},
    "actions": {"type":"array","minItems":14,"items":{"type":"object","required":["id","route","permission","receiptExpected"]}},
    "incidentPhases": {"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","required":["from","to","phase","label","summary","fields"]}},
    "copyRules": {"type":"object","required":["maximumPrimaryActions","maximumHeaderActions","maximumMonitoringServiceActions","maximumIncidentServiceActions","forbiddenPrimaryTerms","emptyStateBoundary"]},
    "limitations": {"type":"array","minItems":4},
    "operatingScenarios": {"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","required":["id","label","services","typicalInputs","roles","highLeverageContext","boundary"]}},
    "roles": {"type":"array","minItems":5,"items":{"type":"object","required":["id","label","permissions"]}}
  }
}
