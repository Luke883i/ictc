{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/audit-event.schema.json",
  "title": "ICTC Append-only Audit Event",
  "type": "object",
  "required": ["id", "type", "actor", "producer", "at", "previousHash", "payload", "hash"],
  "properties": {
    "id": {"type": "string", "minLength": 8},
    "type": {"type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)+$"},
    "actor": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "at": {"type": "string", "format": "date-time"},
    "previousHash": {"type": "string", "minLength": 7},
    "payload": {"type": "object"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
