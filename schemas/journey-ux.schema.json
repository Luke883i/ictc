{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/journey-ux.schema.json",
  "title": "ICTC journey-first UX attestation",
  "type": "object",
  "required": ["schemaVersion","name","claimClass","claim","definitionOfDone","metrics","saturation","limitations"],
  "properties": {
    "claimClass":{"const":"bounded-persona-journey-engineering-attestation"},
    "definitionOfDone":{"type":"array","minItems":18},
    "metrics":{"type":"array","minItems":13},
    "saturation":{"type":"object","required":["M","MPlus100","primitiveCount","lastNoveltyScenario","noveltyAfterM","limitation"],"properties":{"M":{"const":60},"MPlus100":{"const":160},"primitiveCount":{"const":18},"noveltyAfterM":{"const":0}}},
    "limitations":{"type":"array","minItems":4}
  }
}
