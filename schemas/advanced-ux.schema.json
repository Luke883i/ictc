{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ictc.local/schemas/advanced-ux.schema.json",
  "title": "ICTC Advanced UX manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "claimClass", "claim", "layers", "accessibility", "definitionOfDone", "metrics", "saturation", "limitations"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "name": {"type": "string", "minLength": 1},
    "claimClass": {"const": "bounded-ux-engineering-attestation"},
    "claim": {"type": "string", "minLength": 20},
    "layers": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["id", "label", "purpose"]}},
    "accessibility": {"type": "object", "required": ["orientation", "targetSizeCssPixels", "preferences", "keyboard", "adaptations"]},
    "definitionOfDone": {"type": "array", "minItems": 10, "items": {"type": "object", "required": ["id", "criterion", "required"]}},
    "metrics": {"type": "array", "minItems": 8, "items": {"type": "object", "required": ["id", "name", "target", "unit"]}},
    "saturation": {"type": "object", "required": ["M", "MPlus100", "primitiveCount", "noveltyAfterM"]},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 10}}
  }
}
