PORT=4173

# Local development is the default.
# ICTC_IDENTITY_MODE=local

# Shibboleth / trusted reverse proxy deployment:
# ICTC_IDENTITY_MODE=trusted-header
# ICTC_TRUSTED_PROXY_SECRET=replace-with-at-least-32-random-characters
# ICTC_HOST=127.0.0.1
# ICTC_ALLOW_NETWORK_BIND=1

# AI network opt-ins are independent and disabled by default.
# ICTC_ALLOW_PRIVATE_AI=1
# ICTC_ALLOW_INSECURE_AI=1

# Authenticated subject budget (process-local; not distributed multi-host authority).
# ICTC_RATE_LIMIT_BURST=120
# ICTC_RATE_LIMIT_PER_SECOND=2
# ICTC_RATE_LIMIT_KEYS=4096

# Coarse pre-auth tenant + remote edge budget.
# ICTC_EDGE_RATE_LIMIT_BURST=2000
# ICTC_EDGE_RATE_LIMIT_PER_SECOND=100
# ICTC_EDGE_RATE_LIMIT_KEYS=4096
